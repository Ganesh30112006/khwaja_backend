# AWS Elastic Beanstalk (Node.js platform) settings for the Voter Desk API.
# Secrets (DATABASE_URL, CORS_ORIGINS) are set as environment properties in the console or with `aws elasticbeanstalk update-environment`.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    # One load balancer in front of the instances.
    TRUST_PROXY: "1"
    DATABASE_SSL: "true"
    DATABASE_CA_FILE: certs/rds-global-bundle.pem
    APP_TIME_ZONE: Asia/Kolkata
    # The build output is uploaded; only runtime dependencies are installed on the server.
    NPM_USE_PRODUCTION: "true"
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    Port: "8080"
