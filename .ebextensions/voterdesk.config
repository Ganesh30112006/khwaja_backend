# AWS Elastic Beanstalk (Node.js platform) settings for the Voter Desk API.
# Secrets (DATABASE_URL, CORS_ORIGINS, ORIGIN_SECRET) are set as environment properties in the console or with `aws elasticbeanstalk update-environment`.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    # Proxy hops in front of Node: CloudFront + the load balancer + the instance's nginx = 3.
    TRUST_PROXY: "3"
    DATABASE_SSL: "true"
    DATABASE_CA_FILE: certs/rds-global-bundle.pem
    APP_TIME_ZONE: Asia/Kolkata
    # The build output is uploaded; only runtime dependencies are installed on the server.
    NPM_USE_PRODUCTION: "true"
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    # The load balancer sends traffic to nginx on port 80, which proxies to Node on 8080.
    Port: "80"
  # Deploys and config changes start new servers and switch only when they are healthy (no downtime).
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Immutable
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: true
    RollingUpdateType: Immutable
