# Copy to .env for local development. In AWS, set these as Elastic Beanstalk environment properties.

# PostgreSQL connection. Local: `npm run db:local` starts one on port 5433 (no Docker needed).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/voterdesk
# TLS to the database. Keep true for RDS; false for the local database.
DATABASE_SSL=false
# RDS only: Amazon's CA bundle (the deploy package includes it at this path).
# DATABASE_CA_FILE=certs/rds-global-bundle.pem

PORT=8080
# Browser origins allowed to call the API (comma-separated), e.g. https://main.d123.amplifyapp.com
CORS_ORIGINS=http://localhost:5173
# Proxy hops in front of the app (Elastic Beanstalk load balancer = 1) so rate limits see real client IPs.
TRUST_PROXY=0
# Calendar for date filters, "today" and daily/monthly reports.
APP_TIME_ZONE=Asia/Kolkata
# Failed logins allowed per IP per 15 minutes.
LOGIN_RATE_LIMIT=20

# Used once by `npm run create-super-admin` on a new database.
SUPER_ADMIN_NAME=
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_PASSWORD=
INITIAL_PAYMENT_AMOUNT=2000
