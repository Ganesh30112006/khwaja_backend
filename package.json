{
  "name": "voter-desk-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "create-super-admin": "tsx src/scripts/createSuperAdmin.ts",
    "create-super-admin:prod": "node dist/scripts/createSuperAdmin.js",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "db:local": "tsx src/scripts/localDb.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "embedded-postgres": "17.5.0-beta.15",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
